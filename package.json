{
  "name": "gauss-hud",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted car dashboard for Meta Ray-Ban Display glasses",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gauss-hud/web",
    "dev:api": "npm run dev -w @gauss-hud/api",
    "build": "npm run build -w @gauss-hud/web",
    "start": "npm start -w @gauss-hud/api",
    "pair": "npm run pair -w @gauss-hud/api",
    "pin:set": "npm run pin:set -w @gauss-hud/api",
    "sessions:revoke": "npm run sessions:revoke -w @gauss-hud/api",
    "tesla:keys": "npm run tesla:keys -w @gauss-hud/api",
    "tesla:proxy-cert": "npm run tesla:proxy-cert -w @gauss-hud/api",
    "tesla:register": "npm run tesla:register -w @gauss-hud/api",
    "tesla:login": "npm run tesla:login -w @gauss-hud/api",
    "tesla:vehicles": "npm run tesla:vehicles -w @gauss-hud/api",
    "tesla:pair-link": "npm run tesla:pair-link -w @gauss-hud/api",
    "tesla:check": "npm run tesla:check -w @gauss-hud/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "fsevents": false
  }
}
