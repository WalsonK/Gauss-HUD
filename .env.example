# Copy to .env and fill in. Never commit .env.
# Empty values fall back to the defaults documented in the code.

# --- Server ---
PORT=
HOST=
LOG_LEVEL=
DB_PATH=
# Public HTTPS origin of this instance, e.g. https://car.example.com
PUBLIC_ORIGIN=
# Set when running behind a reverse proxy (real client IP for rate limits and the journal)
TRUST_PROXY=
# IANA time zone used for daily caps, e.g. Europe/Paris
APP_TIMEZONE=

# --- Safety and cost control ---
# true = simulate commands without calling the vehicle API
DRY_RUN=
DAILY_MAX_COMMANDS=
DAILY_MAX_WAKES=
# Minimum delay between two vehicle data reads, in seconds
DATA_MIN_INTERVAL_SEC=

# --- Development ---
# Mock vehicle scenario: online | asleep | offline | driving | no_key
MOCK_SCENARIO=

# Vehicle API settings (client ID/secret, region, proxy) arrive in phase 2.
