# Copy to .env and fill in. Never commit .env.
# Empty values fall back to the defaults documented in apps/api/src/config.ts.

# --- Server ---
# Default 3000
PORT=
# Default 127.0.0.1; 0.0.0.0 inside a container
HOST=
# fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=
# Relative paths resolve against the repository root (default data/gauss-hud.db)
DB_PATH=
# Public HTTPS origin of this instance, e.g. https://car.example.com
PUBLIC_ORIGIN=
# true when running behind a reverse proxy (real client IP for rate limits and the journal)
TRUST_PROXY=
# IANA time zone used for daily caps and the monthly cost, e.g. Europe/Paris (default UTC)
APP_TIMEZONE=
# Compiled HUD served by the API (default apps/web/dist)
WEB_DIST=

# --- Safety and cost control ---
# true = simulate wake-ups and commands without calling the vehicle API (reads stay real)
DRY_RUN=
# Default 30
DAILY_MAX_COMMANDS=
# Default 4
DAILY_MAX_WAKES=
# Minimum delay between two vehicle data reads, in seconds (default 120)
DATA_MIN_INTERVAL_SEC=
# Monthly credit of the vehicle API developer account, in euros (default 10)
MONTHLY_CREDIT_EUR=

# --- Vehicle API (Tesla Fleet API) ---
# Leave TESLA_CLIENT_ID empty to run on the mock vehicle. Onboarding order: README > Connect your vehicle.
# OAuth tokens are not set here: they rotate on every refresh and are kept in the database.
# From your application on developer.tesla.com (redirect URI: PUBLIC_ORIGIN + /api/auth/tesla/callback)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# eu | na (default eu)
TESLA_REGION=
# From `npm run tesla:vehicles`; until set, the server stays on the mock
TESLA_VIN=
# Key pair from `npm run tesla:keys` (defaults secrets/public-key.pem, secrets/private-key.pem)
TESLA_PUBLIC_KEY_PATH=
TESLA_PRIVATE_KEY_PATH=
# Signing proxy for commands, internal network only, e.g. https://localhost:4443
TESLA_COMMAND_PROXY_URL=
# The proxy's self-signed TLS certificate, e.g. secrets/proxy-tls/tls-cert.pem
TESLA_PROXY_CA_PATH=

# --- Phone notifications (optional, one per command) ---
# e.g. https://ntfy.example.com
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# --- Development ---
# Mock vehicle scenario: online | asleep | offline | driving | no_key | failing
MOCK_SCENARIO=
